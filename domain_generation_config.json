{
  "output_file": "domains.json",
  "candidate_count": 1000,
  "budget": {
    "max_yearly_price": 2000,
    "currency": "INR"
  },
  "name_length": 4,
  "tlds": [".com"],
  "patterns": ["CVCV", "CVVC"],
  "consonants": "lmnrstvzkpbdghcfwy",
  "vowels": "aeiou",
  "preferred_starts": ["av", "ar", "el", "ev", "iv", "or", "ov", "va", "ve", "vi", "vo", "za", "ze", "zi", "zo", "no", "ne", "re", "ri", "ro", "se", "so", "te", "to"],
  "preferred_ends": ["ra", "re", "ri", "ro", "va", "ve", "vi", "vo", "la", "le", "li", "lo", "na", "ne", "ni", "no"],
  "blocked_fragments": ["q", "x", "jj", "kk", "ww", "yy", "zz"],
  "reject_repeated_letters": true,
  "blocked_names": [
    "test",
    "admin",
    "demo",
    "spam",
    "fake",
    "hate",
    "sex",
    "zero",
    "code",
    "care",
    "dove",
    "five",
    "fire",
    "fine",
    "fuse",
    "home",
    "land",
    "loan",
    "rent",
    "real",
    "sora",
    "viva"
  ],
  "require_alternating_phonetics": true,
  "lowercase": true,
  "deduplicate": true,
  "review_only": true
}
