{
  "input_file": "domains.json",
  "output_directory": "output",
  "batch_size": 25,
  "optimize_for": "ACCURACY",
  "timeout_seconds": 30,
  "delay_between_batches_seconds": 1,
  "max_retries": 5,
  "retry_backoff_seconds": 2,
  "resume_enabled": true,
  "checkpoint_file": "checkpoint.json",
  "remove_duplicates": true,
  "strip_protocol": true,
  "remove_www": false,
  "allowed_tlds": [".com", ".in", ".ai", ".co"],
  "sort_available_by": "domain",
  "save_json": true,
  "save_csv": true,
  "save_markdown": true,
  "save_excel": false,
  "save_buy_now": true,
  "save_logs": true,
  "log_level": "INFO",
  "secrets_file": "GODADDY_PAT.json",
  "godaddy_pat": null,
  "godaddy": {
    "base_url": "https://api.godaddy.com",
    "availability_endpoint": "/v3/domains/check-availability"
  },
  "budget": {
    "max_yearly_price": 5000,
    "max_renewal_price": 6000,
    "currency": "INR",
    "require_renewal_price": false
  },
  "prefilter": {
    "enabled": false,
    "rdap_url": "https://rdap.org/domain/{domain}",
    "timeout_seconds": 10
  }
}
